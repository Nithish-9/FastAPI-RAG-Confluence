# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
ENTERPRISE_COLLECTION=Enterprise_Knowledge_Base
WORKSPACE_COLLECTION=Workspace_Knowledge_Base
QDRANT_ON_DISK=true
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_EF=128
SPARSE_FULL_SCAN_THRESHOLD=1000
DENSE_DISTANCE=COSINE
QDRANT_INDEXING_THREADS=4
QDRANT_RETRIES=5
QDRANT_TIMEOUT=60
RERANK_THRESHOLD=0.0
ENTERPRISE_COLLECTION_DENSE_DIM=768
WORKSPACE_COLLECTION_DENSE_DIM=768

# ─── Embedding Models ─────────────────────────────────────────────────────────
TEXT_DENSE_HOSTED=false
TEXT_DENSE_URL=http://mis-dense-nomic-text:8000
TEXT_DENSE_MODEL_DIM=768

CODE_DENSE_HOSTED=false
CODE_DENSE_URL=http://mis-jina-embeddings-v2-base-code:8000
CODE_DENSE_MODEL_DIM=768

TEXT_SPARSE_HOSTED=false
TEXT_SPARSE_URL=http://mis-sparse-splade-pp:8000

RERANKER_HOSTED=false
RERANKER_URL=http://mis-reranker-jina:8000
MAX_RERANK_CANDIDATES=100

EMBED_BATCH_SIZE=8

# ─── HTTP Client ──────────────────────────────────────────────────────────────
HTTP_TOTAL_TIMEOUT=120.0
HTTP_CONNECT_TIMEOUT=10.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20
HTTP_VERIFY_SSL=false

# ─── Inference Retry ──────────────────────────────────────────────────────────
INFERENCE_MAX_RETRIES=3
INFERENCE_RETRY_MIN_WAIT=2
INFERENCE_RETRY_MAX_WAIT=10

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1
REDIS_CACHE_TTL=86400
REDIS_TASK_RESULT_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT=5
WORKER_PREFETCH_MULTIPLIER=1

CELERY_MAX_RETRIES=5
CELERY_BASE_DELAY_SECONDS=5
CELERY_MAX_DELAY_SECONDS=300

# ─── Chunking ─────────────────────────────────────────────────────────────────
MAX_CHUNK_CHARS=2000
SOFT_CHUNK_CHARS=3000
PREAMBLE_CHARS=200
OVERLAP_CHARS=50
FALLBACK_CHUNK_SIZE=1000
FALLBACK_OVERLAP=100
CHUNK_STORE_DIR=/data/chunks

# ─── Concurrency / Backpressure ───────────────────────────────────────────────
EMBED_RATE_LIMIT=120/m
INFERENCE_SEMAPHORE=1
READ_AHEAD_LIMIT=4
EMBED_CONCURRENCY=4
DBWRITE_QUEUE_MAX=500
BACKPRESSURE_SLEEP=0.5

PYTHONPATH=/app
